@model LeaveType
@{
    ViewData["Title"] = "เพิ่มประเภทการลา";
}

<div class="row">
    <div class="col-md-10 mx-auto">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h4><i class="bi bi-plus-circle"></i> เพิ่มประเภทการลาใหม่</h4>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="row">
                        <div class="col-md-6">
                            <h5 class="text-primary"><i class="bi bi-tag"></i> ข้อมูลพื้นฐาน</h5>
                            <hr>

                            <div class="mb-3">
                                <label asp-for="LeaveTypeCode" class="form-label">รหัสประเภท *</label>
                                <input asp-for="LeaveTypeCode" class="form-control" placeholder="เช่น ANNUAL, SICK" />
                                <span asp-validation-for="LeaveTypeCode" class="text-danger"></span>
                                <small class="form-text text-muted">ตัวพิมพ์ใหญ่เท่านั้น</small>
                            </div>

                            <div class="mb-3">
                                <label asp-for="LeaveTypeName" class="form-label">ชื่อประเภท *</label>
                                <input asp-for="LeaveTypeName" class="form-control" placeholder="เช่น วันลาพักร้อน" />
                                <span asp-validation-for="LeaveTypeName" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Description" class="form-label">คำอธิบาย</label>
                                <textarea asp-for="Description" class="form-control" rows="3" placeholder="อธิบายรายละเอียดของประเภทการลานี้"></textarea>
                                <span asp-validation-for="Description" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="DefaultDays" class="form-label">จำนวนวันมาตรฐาน *</label>
                                <input asp-for="DefaultDays" type="number" step="0.5" class="form-control" value="0" />
                                <span asp-validation-for="DefaultDays" class="text-danger"></span>
                                <small class="form-text text-muted">สามารถใส่ทศนิยมได้ เช่น 10.5 วัน</small>
                            </div>

                            <div class="mb-3">
                                <label asp-for="MaxConsecutiveDays" class="form-label">จำนวนวันต่อเนื่องสูงสุด</label>
                                <input asp-for="MaxConsecutiveDays" type="number" class="form-control" placeholder="เว้นว่างหากไม่จำกัด" />
                                <span asp-validation-for="MaxConsecutiveDays" class="text-danger"></span>
                                <small class="form-text text-muted">จำนวนวันที่สามารถลาต่อเนื่องได้สูงสุด (ถ้ามี)</small>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <h5 class="text-primary"><i class="bi bi-gear"></i> การตั้งค่า</h5>
                            <hr>

                            <div class="mb-3 form-check">
                                <input asp-for="IsProRated" class="form-check-input" />
                                <label asp-for="IsProRated" class="form-check-label">คำนวณแบบ Pro-rate</label>
                                <small class="form-text text-muted d-block">
                                    หากเลือก จะคำนวณวันลาตามอายุงาน (เช่น วันลาพักร้อน)
                                </small>
                            </div>

                            <div class="mb-3 form-check">
                                <input asp-for="IsPaidLeave" class="form-check-input" checked />
                                <label asp-for="IsPaidLeave" class="form-check-label">ลาได้รับค่าจ้าง</label>
                                <small class="form-text text-muted d-block">
                                    พนักงานได้รับเงินเดือนขณะลาหรือไม่
                                </small>
                            </div>

                            <div class="mb-3 form-check">
                                <input asp-for="RequiresDocumentation" class="form-check-input" />
                                <label asp-for="RequiresDocumentation" class="form-check-label">ต้องแนบเอกสาร</label>
                                <small class="form-text text-muted d-block">
                                    จำเป็นต้องแนบเอกสารประกอบคำขอลาหรือไม่
                                </small>
                            </div>

                            <div class="mb-3 form-check">
                                <input asp-for="RequiresGender" class="form-check-input" id="requiresGender" />
                                <label asp-for="RequiresGender" class="form-check-label">จำกัดเพศ</label>
                                <small class="form-text text-muted d-block">
                                    เฉพาะเพศใดเพศหนึ่งเท่านั้นที่สามารถใช้ได้
                                </small>
                            </div>

                            <div class="mb-3" id="genderSelectDiv" style="display: none;">
                                <label asp-for="ApplicableGender" class="form-label">เพศที่ใช้ได้</label>
                                <select asp-for="ApplicableGender" class="form-select">
                                    <option value="">-- ไม่จำกัด --</option>
                                    <option value="Male">ชายเท่านั้น</option>
                                    <option value="Female">หญิงเท่านั้น</option>
                                </select>
                                <span asp-validation-for="ApplicableGender" class="text-danger"></span>
                            </div>

                            <div class="mb-3 form-check">
                                <input asp-for="IsActive" class="form-check-input" checked />
                                <label asp-for="IsActive" class="form-check-label">เปิดใช้งาน</label>
                            </div>

                            <div class="alert alert-info mt-3">
                                <h6><i class="bi bi-info-circle"></i> ตัวอย่างประเภทการลา</h6>
                                <ul class="mb-0 small">
                                    <li><strong>วันลาพักร้อน:</strong> Pro-rate, Paid, ไม่จำกัดเพศ</li>
                                    <li><strong>วันลาป่วย:</strong> ไม่ Pro-rate, Paid, ไม่จำกัดเพศ</li>
                                    <li><strong>วันลาคลอด:</strong> ไม่ Pro-rate, Paid, หญิงเท่านั้น, ต้องมีเอกสาร</li>
                                </ul>
                            </div>
                        </div>
                    </div>

                    <hr>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> ย้อนกลับ
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-save"></i> บันทึก
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function() {
            // Show/hide gender selection based on RequiresGender checkbox
            $('#requiresGender').change(function() {
                if ($(this).is(':checked')) {
                    $('#genderSelectDiv').slideDown();
                } else {
                    $('#genderSelectDiv').slideUp();
                    $('#ApplicableGender').val('');
                }
            });

            // Initial state
            if ($('#requiresGender').is(':checked')) {
                $('#genderSelectDiv').show();
            }
        });
    </script>
}
