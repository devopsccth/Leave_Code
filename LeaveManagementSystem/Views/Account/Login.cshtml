@model LoginViewModel
@{
    Layout = "_LoginLayout";
    ViewData["Title"] = "เข้าสู่ระบบ";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="login-card p-5">
                <div class="text-center mb-4">
                    <i class="bi bi-calendar-check display-1 text-primary"></i>
                    <h2 class="mt-3">ระบบบริหารจัดการการลา</h2>
                    <p class="text-muted">Leave Management System</p>
                </div>

                <form asp-action="Login" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">
                            <i class="bi bi-envelope"></i> อีเมล
                        </label>
                        <input asp-for="Email" class="form-control form-control-lg" placeholder="your-email@company.com" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label">
                            <i class="bi bi-lock"></i> รหัสผ่าน
                        </label>
                        <input asp-for="Password" class="form-control form-control-lg" placeholder="••••••••" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="mb-3 form-check">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label">
                            จดจำการเข้าสู่ระบบ
                        </label>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary btn-lg">
                            <i class="bi bi-box-arrow-in-right"></i> เข้าสู่ระบบ
                        </button>
                    </div>
                </form>

                <hr class="my-4">

                <div class="text-center">
                    <small class="text-muted">
                        <strong>Demo Accounts:</strong><br>
                        Admin: admin@@company.com / Password123!<br>
                        Employee: dev1@@company.com / Password123!
                    </small>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
