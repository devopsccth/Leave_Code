@model EmployeeViewModel
@{
    ViewData["Title"] = "เพิ่มพนักงาน";
}

<div class="row">
    <div class="col-md-10 mx-auto">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h4><i class="bi bi-person-plus"></i> เพิ่มพนักงานใหม่</h4>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="row">
                        <div class="col-md-6">
                            <h5 class="text-primary"><i class="bi bi-person-badge"></i> ข้อมูลพื้นฐาน</h5>
                            <hr>

                            <div class="mb-3">
                                <label asp-for="EmployeeCode" class="form-label">รหัสพนักงาน *</label>
                                <input asp-for="EmployeeCode" class="form-control" placeholder="เช่น EMP001" />
                                <span asp-validation-for="EmployeeCode" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Email" class="form-label">อีเมล *</label>
                                <input asp-for="Email" type="email" class="form-control" placeholder="example@company.com" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Password" class="form-label">รหัสผ่าน *</label>
                                <input asp-for="Password" type="password" class="form-control" />
                                <span asp-validation-for="Password" class="text-danger"></span>
                                <small class="form-text text-muted">ควรมีอย่างน้อย 8 ตัวอักษร</small>
                            </div>

                            <div class="mb-3">
                                <label asp-for="FirstName" class="form-label">ชื่อ *</label>
                                <input asp-for="FirstName" class="form-control" />
                                <span asp-validation-for="FirstName" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="LastName" class="form-label">นามสกุล *</label>
                                <input asp-for="LastName" class="form-control" />
                                <span asp-validation-for="LastName" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Gender" class="form-label">เพศ *</label>
                                <select asp-for="Gender" class="form-select">
                                    <option value="">-- เลือกเพศ --</option>
                                    <option value="Male">ชาย</option>
                                    <option value="Female">หญิง</option>
                                    <option value="Other">อื่นๆ</option>
                                </select>
                                <span asp-validation-for="Gender" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="DateOfBirth" class="form-label">วันเกิด</label>
                                <input asp-for="DateOfBirth" type="date" class="form-control" />
                                <span asp-validation-for="DateOfBirth" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="HireDate" class="form-label">วันที่เริ่มงาน *</label>
                                <input asp-for="HireDate" type="date" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                                <span asp-validation-for="HireDate" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <h5 class="text-primary"><i class="bi bi-building"></i> ข้อมูลองค์กร</h5>
                            <hr>

                            <div class="mb-3">
                                <label asp-for="DepartmentId" class="form-label">แผนก *</label>
                                <select asp-for="DepartmentId" class="form-select" id="departmentSelect">
                                    <option value="">-- เลือกแผนก --</option>
                                    @foreach (var dept in ViewBag.Departments as IEnumerable<Department>)
                                    {
                                        <option value="@dept.DepartmentId">@dept.DepartmentName</option>
                                    }
                                </select>
                                <span asp-validation-for="DepartmentId" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="PositionId" class="form-label">ตำแหน่ง *</label>
                                <select asp-for="PositionId" class="form-select">
                                    <option value="">-- เลือกตำแหน่ง --</option>
                                    @foreach (var pos in ViewBag.Positions as IEnumerable<Position>)
                                    {
                                        <option value="@pos.PositionId" data-dept="@pos.DepartmentId">
                                            @pos.PositionName (@pos.DepartmentName)
                                        </option>
                                    }
                                </select>
                                <span asp-validation-for="PositionId" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="ManagerId" class="form-label">ผู้จัดการ</label>
                                <select asp-for="ManagerId" class="form-select">
                                    <option value="">-- ไม่มีผู้จัดการ --</option>
                                    @foreach (var mgr in ViewBag.Managers as IEnumerable<Employee>)
                                    {
                                        <option value="@mgr.EmployeeId">
                                            @mgr.FullName (@mgr.DepartmentName)
                                        </option>
                                    }
                                </select>
                                <span asp-validation-for="ManagerId" class="text-danger"></span>
                                <small class="form-text text-muted">ผู้จัดการต้องมี Role เป็น Manager, HR หรือ Admin</small>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Role" class="form-label">บทบาท *</label>
                                <select asp-for="Role" class="form-select">
                                    <option value="">-- เลือกบทบาท --</option>
                                    <option value="Employee">พนักงานทั่วไป (Employee)</option>
                                    <option value="Manager">ผู้จัดการ (Manager)</option>
                                    <option value="HR">ฝ่ายทรัพยากรบุคคล (HR)</option>
                                    <option value="Admin">ผู้ดูแลระบบ (Admin)</option>
                                </select>
                                <span asp-validation-for="Role" class="text-danger"></span>
                            </div>

                            <div class="mb-3 form-check">
                                <input asp-for="IsActive" class="form-check-input" checked />
                                <label asp-for="IsActive" class="form-check-label">เปิดใช้งาน</label>
                            </div>

                            <div class="alert alert-info mt-3">
                                <h6><i class="bi bi-info-circle"></i> คำอธิบายบทบาท</h6>
                                <ul class="mb-0 small">
                                    <li><strong>Employee:</strong> พนักงานทั่วไป สามารถขอลาได้</li>
                                    <li><strong>Manager:</strong> ผู้จัดการ อนุมัติคำขอลาของลูกน้อง</li>
                                    <li><strong>HR:</strong> ฝ่าย HR จัดการข้อมูลพนักงานและดูรายงาน</li>
                                    <li><strong>Admin:</strong> ผู้ดูแลระบบ เข้าถึงได้ทุกฟังก์ชัน</li>
                                </ul>
                            </div>
                        </div>
                    </div>

                    <hr>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> ย้อนกลับ
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-save"></i> บันทึก
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Filter positions by selected department
        $(document).ready(function() {
            $('#departmentSelect').change(function() {
                var selectedDept = $(this).val();
                $('#PositionId option').each(function() {
                    var positionDept = $(this).data('dept');
                    if (positionDept == selectedDept || $(this).val() === '') {
                        $(this).show();
                    } else {
                        $(this).hide();
                    }
                });
                $('#PositionId').val('');
            });
        });
    </script>
}
