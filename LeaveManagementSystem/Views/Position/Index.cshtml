@model IEnumerable<Position>
@{ ViewData["Title"] = "จัดการตำแหน่ง"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-briefcase"></i> จัดการตำแหน่ง</h2>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> เพิ่มตำแหน่ง
    </a>
</div>

<div class="card">
    <div class="card-body">
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>รหัส</th>
                            <th>ชื่อตำแหน่ง</th>
                            <th>แผนก</th>
                            <th>จำนวนพนักงาน</th>
                            <th>สถานะ</th>
                            <th>การดำเนินการ</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.PositionCode</td>
                                <td>@item.PositionName</td>
                                <td>
                                    <span class="badge bg-info">@item.DepartmentName</span>
                                </td>
                                <td>
                                    <span class="badge bg-secondary">@item.EmployeeCount คน</span>
                                </td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success">ใช้งาน</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">ไม่ใช้งาน</span>
                                    }
                                </td>
                                <td>
                                    <a asp-action="Edit" asp-route-id="@item.PositionId" class="btn btn-sm btn-warning">
                                        <i class="bi bi-pencil"></i> แก้ไข
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@item.PositionId" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('คุณแน่ใจหรือไม่ที่จะลบตำแหน่งนี้?')">
                                            <i class="bi bi-trash"></i> ลบ
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info">
                <i class="bi bi-info-circle"></i> ยังไม่มีข้อมูลตำแหน่ง
            </div>
        }
    </div>
</div>
