@model IEnumerable<LeaveBalance>
@{
    ViewData["Title"] = "รายงานวันลาทีม";
}

<div class="card">
    <div class="card-header bg-primary text-white">
        <div class="d-flex justify-content-between align-items-center">
            <h4><i class="bi bi-bar-chart"></i> รายงานวันลาของทีม</h4>
            <form method="get" class="d-flex gap-2">
                <select name="year" class="form-select" onchange="this.form.submit()">
                    @foreach (var y in ViewBag.Years)
                    {
                        <option value="@y" selected="@(y == ViewBag.Year)">ปี @(y + 543)</option>
                    }
                </select>
            </form>
        </div>
    </div>
    <div class="card-body">
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>พนักงาน</th>
                            <th>แผนก</th>
                            <th>ตำแหน่ง</th>
                            <th>ประเภทการลา</th>
                            <th class="text-center">จำนวนวัน</th>
                            <th class="text-center">ใช้ไป</th>
                            <th class="text-center">คงเหลือ</th>
                            <th class="text-center">% การใช้</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var usagePercent = item.EntitledDays > 0 ? (item.UsedDays / item.EntitledDays * 100) : 0;
                            <tr>
                                <td>@item.EmployeeName</td>
                                <td>@item.DepartmentName</td>
                                <td>@item.PositionName</td>
                                <td><span class="badge bg-secondary">@item.LeaveTypeName</span></td>
                                <td class="text-center">@item.EntitledDays</td>
                                <td class="text-center">@item.UsedDays</td>
                                <td class="text-center">
                                    <strong class="@(item.RemainingDays < 1 ? "text-danger" : "text-success")">
                                        @item.RemainingDays
                                    </strong>
                                </td>
                                <td class="text-center">
                                    <div class="progress" style="height: 20px;">
                                        <div class="progress-bar @(usagePercent > 80 ? "bg-danger" : usagePercent > 50 ? "bg-warning" : "bg-success")"
                                             role="progressbar" style="width: @usagePercent.ToString("F0")%">
                                            @usagePercent.ToString("F0")%
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info text-center">
                <i class="bi bi-inbox" style="font-size: 3rem;"></i>
                <h5 class="mt-3">ไม่มีข้อมูล</h5>
                <p>ไม่พบข้อมูลวันลาของทีมในปีที่เลือก</p>
            </div>
        }
    </div>
</div>
