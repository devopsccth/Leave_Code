@model IEnumerable<EmployeeLeaveBalancePivotViewModel>
@{
    ViewData["Title"] = "รายงานวันลาทั้งหมด";
    var leaveTypeCodes = ViewBag.LeaveTypeCodes as List<string> ?? new List<string>();
}

<div class="card">
    <div class="card-header bg-success text-white">
        <h4><i class="bi bi-file-earmark-bar-graph"></i> รายงานวันลาพนักงานทั้งหมด (แบบ Pivot)</h4>
    </div>
    <div class="card-body">
        <form method="get" class="row g-3 mb-4">
            <div class="col-md-6">
                <label class="form-label">ปี</label>
                <select name="year" class="form-select">
                    @foreach (var y in ViewBag.Years)
                    {
                        <option value="@y" selected="@(y == ViewBag.Year)">ปี @(y + 543)</option>
                    }
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label">แผนก</label>
                <select name="departmentId" class="form-select">
                    <option value="">-- ทุกแผนก --</option>
                    @foreach (var dept in ViewBag.Departments as IEnumerable<Department>)
                    {
                        <option value="@dept.DepartmentId" selected="@(dept.DepartmentId == ViewBag.DepartmentId)">
                            @dept.DepartmentName
                        </option>
                    }
                </select>
            </div>
            <div class="col-12">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-search"></i> ค้นหา
                </button>
            </div>
        </form>

        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table id="allEmployeesLeaveTable" class="table table-hover table-sm table-bordered">
                    <thead class="table-light">
                        <tr>
                            <th rowspan="2" class="align-middle text-center">รหัส</th>
                            <th rowspan="2" class="align-middle">ชื่อ-สกุล</th>
                            <th rowspan="2" class="align-middle">แผนก</th>
                            <th rowspan="2" class="align-middle">ตำแหน่ง</th>
                            @foreach (var leaveTypeCode in leaveTypeCodes)
                            {
                                <th colspan="3" class="text-center bg-info bg-opacity-10">
                                    @{
                                        var sampleBalance = Model
                                            .SelectMany(m => m.LeaveBalances)
                                            .FirstOrDefault(lb => lb.Key == leaveTypeCode);
                                        var leaveTypeName = sampleBalance.Value?.LeaveTypeName ?? leaveTypeCode;
                                    }
                                    @leaveTypeName
                                </th>
                            }
                        </tr>
                        <tr>
                            @foreach (var leaveTypeCode in leaveTypeCodes)
                            {
                                <th class="text-center" style="font-size: 0.85rem;">สิทธิ์</th>
                                <th class="text-center" style="font-size: 0.85rem;">ใช้</th>
                                <th class="text-center" style="font-size: 0.85rem;">เหลือ</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var employee in Model)
                        {
                            <tr>
                                <td><small>@employee.EmployeeCode</small></td>
                                <td>@employee.EmployeeName</td>
                                <td>@employee.DepartmentName</td>
                                <td>@employee.PositionName</td>
                                @foreach (var leaveTypeCode in leaveTypeCodes)
                                {
                                    if (employee.LeaveBalances.ContainsKey(leaveTypeCode))
                                    {
                                        var balance = employee.LeaveBalances[leaveTypeCode];
                                        var usagePercent = balance.UsagePercentage;
                                        <td class="text-center">@balance.EntitledDays</td>
                                        <td class="text-center">
                                            <span class="@(balance.UsedDays > 0 ? "text-warning fw-bold" : "")">
                                                @balance.UsedDays
                                            </span>
                                        </td>
                                        <td class="text-center">
                                            <span class="@(balance.RemainingDays < 1 ? "text-danger fw-bold" : balance.RemainingDays < balance.EntitledDays * 0.3m ? "text-warning fw-bold" : "text-success")">
                                                @balance.RemainingDays
                                            </span>
                                        </td>
                                    }
                                    else
                                    {
                                        <td class="text-center text-muted">-</td>
                                        <td class="text-center text-muted">-</td>
                                        <td class="text-center text-muted">-</td>
                                    }
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="alert alert-light mt-3">
                <h6><i class="bi bi-info-circle-fill text-info"></i> คำอธิบาย</h6>
                <ul class="mb-0 small">
                    <li><strong>สิทธิ์</strong> = จำนวนวันลาที่มีสิทธิ์ทั้งหมด</li>
                    <li><strong>ใช้</strong> = จำนวนวันที่ใช้ไปแล้ว (สีเหลือง = มีการใช้)</li>
                    <li><strong>เหลือ</strong> = จำนวนวันที่เหลือ (สีแดง = ใช้หมด, สีเหลือง = เหลือน้อย, สีเขียว = เหลือเยอะ)</li>
                </ul>
            </div>
        }
        else
        {
            <div class="alert alert-info text-center">
                <i class="bi bi-inbox" style="font-size: 3rem;"></i>
                <h5 class="mt-3">ไม่มีข้อมูล</h5>
                <p>ไม่พบข้อมูลตามเงื่อนไขที่เลือก</p>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#allEmployeesLeaveTable').DataTable({
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.7/i18n/th.json'
                },
                order: [[0, 'asc']],
                pageLength: 50,
                scrollX: true,
                fixedColumns: {
                    left: 4
                }
            });
        });
    </script>
}
